{%- comment -%}
  Lookbook: a swipeable row of tall photos. Each look can have up to 3 dots placed
  on the photo; tapping a dot shows that piece (in the chosen colour) to shop it.
{%- endcomment -%}
<drift-lookbook class="drift-lookbook">
  <div class="drift-lookbook__head drift-wrap">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="drift-label drift-accent">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="drift-rail__title">{{ section.settings.title }}</h2>
    </div>
    <p class="drift-lookbook__hint drift-label">Tap the dots to shop the look</p>
  </div>
  <div class="drift-lookbook__track">
    {%- for block in section.blocks -%}
      <figure class="drift-look" {{ block.shopify_attributes }}>
        <div class="drift-look__media">
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 1400 | image_tag:
                widths: '500, 800, 1100, 1400',
                sizes: '(min-width: 750px) 40vw, 80vw',
                loading: 'lazy',
                alt: block.settings.caption
            }}
          {%- endif -%}
          {%- for n in (1..3) -%}
            {%- assign pkey = 'product_' | append: n -%}
            {%- assign spot_product = block.settings[pkey] -%}
            {%- if spot_product != blank -%}
              {%- assign xkey = 'x_' | append: n -%}
              {%- assign ykey = 'y_' | append: n -%}
              {%- assign ckey = 'colour_' | append: n -%}
              {%- assign wanted = block.settings[ckey] | downcase -%}
              {%- assign spot_image = spot_product.featured_image -%}
              {%- assign spot_url = spot_product.url -%}
              {%- if wanted != blank -%}
                {%- for v in spot_product.variants -%}
                  {%- assign v_colour = v.option1 | downcase -%}
                  {%- if v_colour == wanted -%}
                    {%- if v.featured_image -%}{%- assign spot_image = v.featured_image -%}{%- endif -%}
                    {%- assign spot_url = v.url -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              <div class="drift-spot" style="left: {{ block.settings[xkey] }}%; top: {{ block.settings[ykey] }}%;">
                <button type="button" class="drift-spot__dot" aria-label="Show {{ spot_product.title | escape }}" aria-expanded="false"></button>
                <a class="drift-spot__card" href="{{ spot_url }}">
                  {%- if spot_image -%}{{ spot_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
                  <span>
                    <b>{{ spot_product.title }}</b>
                    {%- if block.settings[ckey] != blank -%}<i>{{ block.settings[ckey] }}</i>{%- endif -%}
                    <em>{{ spot_product.price | money_without_trailing_zeros }}</em>
                  </span>
                </a>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if block.settings.caption != blank -%}
          <figcaption class="drift-label">{{ block.settings.caption }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
</drift-lookbook>

{% schema %}
{
  "name": "DRIFT lookbook",
  "class": "drift-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above", "default": "Lookbook" },
    { "type": "text", "id": "title", "label": "Title", "default": "Wear the drift" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (portrait)" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Look 01" },
        { "type": "header", "content": "Dot 1" },
        { "type": "product", "id": "product_1", "label": "Product" },
        { "type": "text", "id": "colour_1", "label": "Colour (optional)", "info": "Exact colour name, e.g. Black" },
        { "type": "range", "id": "x_1", "label": "Left → right (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "y_1", "label": "Top → bottom (%)", "min": 0, "max": 100, "step": 1, "default": 45 },
        { "type": "header", "content": "Dot 2" },
        { "type": "product", "id": "product_2", "label": "Product" },
        { "type": "text", "id": "colour_2", "label": "Colour (optional)" },
        { "type": "range", "id": "x_2", "label": "Left → right (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "y_2", "label": "Top → bottom (%)", "min": 0, "max": 100, "step": 1, "default": 75 },
        { "type": "header", "content": "Dot 3" },
        { "type": "product", "id": "product_3", "label": "Product" },
        { "type": "text", "id": "colour_3", "label": "Colour (optional)" },
        { "type": "range", "id": "x_3", "label": "Left → right (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "y_3", "label": "Top → bottom (%)", "min": 0, "max": 100, "step": 1, "default": 30 }
      ]
    }
  ],
  "presets": [{ "name": "DRIFT lookbook", "blocks": [{ "type": "look" }, { "type": "look" }] }]
}
{% endschema %}
