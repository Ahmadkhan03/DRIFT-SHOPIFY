{%- comment -%} Endless strip of big condensed words with maroon ✦ separators. {%- endcomment -%}
<div class="drift-marquee" style="--drift-marquee-duration: {{ section.settings.duration }}s;">
  <div class="drift-marquee__track" aria-hidden="true">
    {%- for i in (1..2) -%}
      <div class="drift-marquee__group">
        {%- for block in section.blocks -%}
          <span class="drift-marquee__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          <span class="drift-marquee__sep">✦</span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
  <p class="visually-hidden">{% for block in section.blocks %}{{ block.settings.text }}{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
</div>

{% schema %}
{
  "name": "DRIFT marquee",
  "class": "drift-section",
  "settings": [
    { "type": "range", "id": "duration", "label": "Speed (seconds per loop)", "min": 10, "max": 80, "step": 5, "default": 40 }
  ],
  "blocks": [
    { "type": "item", "name": "Word", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "New season" }] }
  ],
  "presets": [{ "name": "DRIFT marquee", "blocks": [{ "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
