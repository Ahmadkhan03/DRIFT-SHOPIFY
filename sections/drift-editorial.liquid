{%- comment -%} Editorial block: large photo with an overlapping small one, story text, three stats and a button. {%- endcomment -%}
<div class="drift-editorial drift-wrap">
  <div class="drift-editorial__media">
    <div class="drift-editorial__main">
      {%- if section.settings.main -%}
        {{ section.settings.main | image_url: width: 1400 | image_tag: widths: '600, 900, 1400', sizes: '(min-width: 750px) 50vw, 84vw', loading: 'lazy', alt: section.settings.title, data-parallax: '0.08' }}
      {%- endif -%}
    </div>
    <div class="drift-editorial__inset">
      {%- if section.settings.inset -%}
        {{ section.settings.inset | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 750px) 20vw, 46vw', loading: 'lazy', alt: '' }}
      {%- endif -%}
    </div>
  </div>
  <div class="drift-editorial__text">
    {%- if section.settings.eyebrow != blank -%}<p class="drift-label drift-accent">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="drift-editorial__title">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}<div class="drift-editorial__body">{{ section.settings.text }}</div>{%- endif -%}
    <dl class="drift-stats">
      {%- for n in (1..3) -%}
        {%- assign vk = 'stat_' | append: n | append: '_value' -%}
        {%- assign lk = 'stat_' | append: n | append: '_label' -%}
        {%- if section.settings[vk] != blank -%}
          <div><dt>{{ section.settings[vk] }}</dt><dd class="drift-label">{{ section.settings[lk] }}</dd></div>
        {%- endif -%}
      {%- endfor -%}
    </dl>
    {%- if section.settings.button_label != blank -%}
      <a class="drift-btn drift-btn--outline" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "DRIFT editorial",
  "class": "drift-section",
  "settings": [
    { "type": "image_picker", "id": "main", "label": "Large photo" },
    { "type": "image_picker", "id": "inset", "label": "Small photo" },
    { "type": "text", "id": "eyebrow", "label": "Small text above", "default": "The DRIFT standard" },
    { "type": "text", "id": "title", "label": "Title", "default": "Made in Pakistan. Worn everywhere." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1", "default": "100%" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "Made in Pakistan" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2", "default": "07" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "Day exchange" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3", "default": "COD" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 label", "default": "Nationwide" },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Our story" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "DRIFT editorial" }]
}
{% endschema %}
