{%- comment -%} Branded "page not found": giant 404, a line, buttons and quick links. {%- endcomment -%}
{%- comment -%}
  Old driftpk.com (pre-Shopify) addresses: send visitors to the matching Shopify page
  straight away. Real 301 redirects for the main pages are also set in
  Online Store → Navigation → URL redirects; this catches everything else.
{%- endcomment -%}
<script>
  (function () {
    var p = location.pathname.replace(/\/+$/, '').toLowerCase() || '/';
    var pages = {
      '/shop': '/collections/all', '/men': '/collections/men', '/women': '/collections/women',
      '/about': '/pages/about', '/contact': '/pages/contact', '/faq': '/pages/faq',
      '/size-guide': '/pages/size-guide', '/track-order': '/pages/track-order',
      '/shipping': '/policies/shipping-policy', '/returns': '/policies/refund-policy',
      '/privacy': '/policies/privacy-policy', '/terms': '/policies/terms-of-service',
      '/checkout': '/cart'
    };
    // Old category names → Shopify collection handles
    var cats = { hoodies: 'hoodies', sweatshirts: 'polo-shirts', 'polo-shirts': 'polo-shirts', trousers: 'trousers' };
    var to = pages[p], m;
    if (!to && (m = p.match(/^\/product\/([^/]+)$/))) to = '/products/' + m[1];
    if (!to && (m = p.match(/^\/shop\/([^/]+)$/))) to = '/collections/' + (cats[m[1]] || m[1]);
    if (!to && (m = p.match(/^\/(men|women)\/([^/]+)$/))) to = '/collections/' + m[1] + '/' + (cats[m[2]] || m[2]);
    if (!to && /^\/order\//.test(p)) to = '/pages/track-order';
    if (to) location.replace(to + location.search);
  })();
</script>
<div class="drift-404">
  <p class="drift-404__num" aria-hidden="true">404</p>
  <div class="drift-404__body drift-wrap">
    <p class="drift-label drift-accent">Page not found</p>
    <h1 class="drift-404__title">{{ section.settings.title }}</h1>
    <p class="drift-404__text">{{ section.settings.text }}</p>
    <div class="drift-hero__ctas">
      <a class="drift-btn drift-btn--dark" href="{{ routes.all_products_collection_url }}">Shop all</a>
      <a class="drift-btn drift-btn--outline" href="{{ routes.root_url }}">Back home</a>
    </div>
    <div class="drift-404__links">
      {%- for c in section.settings.links -%}<a href="{{ c.url }}">{{ c.title }}</a>{%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "DRIFT 404",
  "class": "drift-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Lost in the drift" },
    { "type": "text", "id": "text", "label": "Text", "default": "This page moved or never existed. The good stuff is still here." },
    { "type": "collection_list", "id": "links", "label": "Quick links" }
  ]
}
{% endschema %}
